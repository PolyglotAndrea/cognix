# =============================================================================
# Cognix — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# All variables use the COGNIX_ prefix. Nested settings use __ (double underscore).
# Example: COGNIX_DATABASE__URL=postgresql+asyncpg://...
# =============================================================================

# --- General -----------------------------------------------------------------
COGNIX_DEBUG=true
COGNIX_LOG_LEVEL=INFO
# COGNIX_DATA_DIR=~/.cognix

# --- LLM Defaults ------------------------------------------------------------
COGNIX_DEFAULT_MODEL=gpt-4o
COGNIX_LLM_API_KEY=sk-...
# COGNIX_LLM_BASE_URL=https://api.openai.com/v1

# --- Database ----------------------------------------------------------------
# Default: sqlite+aiosqlite:///./cognix.db
# COGNIX_DATABASE__URL=postgresql+asyncpg://user:pass@localhost:5432/cognix
# COGNIX_DATABASE__ECHO=false

# --- Server ------------------------------------------------------------------
# COGNIX_SERVER__HOST=0.0.0.0
# COGNIX_SERVER__PORT=8000
# COGNIX_SERVER__RELOAD=false
# COGNIX_SERVER__WORKERS=1

# --- Auth --------------------------------------------------------------------
COGNIX_AUTH__SECRET_KEY=change-me-in-production
# COGNIX_AUTH__TOKEN_EXPIRE_HOURS=24
# COGNIX_AUTH__FRONTEND_URL=http://localhost:5173

# OAuth — Google
# COGNIX_AUTH__GOOGLE_CLIENT_ID=...
# COGNIX_AUTH__GOOGLE_CLIENT_SECRET=...

# OAuth — GitHub
# COGNIX_AUTH__GITHUB_CLIENT_ID=...
# COGNIX_AUTH__GITHUB_CLIENT_SECRET=...

# --- Billing (Stripe) --------------------------------------------------------
# COGNIX_BILLING__STRIPE_SECRET_KEY=sk_...
# COGNIX_BILLING__STRIPE_WEBHOOK_SECRET=whsec_...
# COGNIX_BILLING__STRIPE_PRICE_STARTER=price_...
# COGNIX_BILLING__STRIPE_PRICE_PRO=price_...

# --- Connectors --------------------------------------------------------------
# COGNIX_CONNECTORS__ENCRYPTION_KEY=...   # Fernet key; falls back to auth.secret_key
# COGNIX_CONNECTORS__X_CLIENT_ID=...
# COGNIX_CONNECTORS__X_CLIENT_SECRET=...
# COGNIX_CONNECTORS__INSTAGRAM_CLIENT_ID=...
# COGNIX_CONNECTORS__INSTAGRAM_CLIENT_SECRET=...

# --- Scheduler ---------------------------------------------------------------
# COGNIX_SCHEDULER__DISPATCHER_POLL_INTERVAL=5.0
# COGNIX_SCHEDULER__DISPATCHER_BATCH_SIZE=10
# COGNIX_SCHEDULER__DISPATCHER_MAX_CONCURRENT=3
# COGNIX_SCHEDULER__DISPATCHER_LEASE_TTL_SECONDS=120
# COGNIX_SCHEDULER__RETRY_BASE_SECONDS=30
# COGNIX_SCHEDULER__RETRY_MAX_SECONDS=3600

# --- Memory ------------------------------------------------------------------
# COGNIX_MEMORY__COMPRESS_MODEL=gpt-4o-mini
# COGNIX_MEMORY__COMPRESS_OLDER_THAN_DAYS=7
# COGNIX_MEMORY__COMPRESS_BATCH_SIZE=5
# COGNIX_MEMORY__AUTO_COMPRESS_ENABLED=false
# COGNIX_MEMORY__AUTO_COMPRESS_INTERVAL_HOURS=24

# --- RPC ---------------------------------------------------------------------
# COGNIX_RPC__HOST=0.0.0.0
# COGNIX_RPC__PORT=8001
# COGNIX_RPC__TRANSPORT=http   # http | websocket | unix

# --- Skills ------------------------------------------------------------------
# COGNIX_SKILLS__LOCAL_DIR=~/.cognix/skills
# COGNIX_SKILLS__REGISTRY_URL=https://registry.cognix.dev
# COGNIX_SKILLS__SANDBOX_ENABLED=true
